# Trader — environment variables for the trading track.
# Copy to .env (git-ignored) and fill in. NEVER commit .env.

# ──────────────────────────────────────────────────────────────
# Trading mode — paper or live
# ──────────────────────────────────────────────────────────────
TRADER_LIVE=false
TRADER_I_UNDERSTAND_THE_RISK=false

# ──────────────────────────────────────────────────────────────
# Alpaca (paper trading + market data)
# Paper keys: https://alpaca.markets/  -> Paper Trading -> View API Keys
# ──────────────────────────────────────────────────────────────
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# ──────────────────────────────────────────────────────────────
# LLM provider (litellm routes to whichever is set)
# ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TRADER_LLM_MODEL=claude-haiku-4-5-20251001

# ──────────────────────────────────────────────────────────────
# Data providers (free tiers fine for v0)
# Finnhub:  https://finnhub.io/
# FRED:     https://fred.stlouisfed.org/docs/api/api_key.html
# ThetaData: keep raw credentials outside the repo and point to the creds file.
# ──────────────────────────────────────────────────────────────
FINNHUB_API_KEY=
FRED_API_KEY=
THETADATA_CREDENTIALS_FILE=/Users/yourname/.thetadata/creds.txt

# ──────────────────────────────────────────────────────────────
# Notifications
# Discord webhook: server -> channel -> Integrations -> Webhooks -> New
# ntfy: install the phone app, subscribe to NTFY_TOPIC, then set
# TRADER_ALERTS_ENABLED=true once you want alerts. Leave disabled for local tests.
# ──────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
TRADER_ALERTS_ENABLED=false
NTFY_TOPIC=
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOKEN=

# ──────────────────────────────────────────────────────────────
# Strategy config
# ──────────────────────────────────────────────────────────────
TRADER_TICKER=QQQ
TRADER_CONTEXT_TICKERS=QQQ,SPY
TRADER_SEC_TICKERS=AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,AVGO
# SEC requires a User-Agent identifying yourself. SET YOUR EMAIL.
TRADER_SEC_USER_AGENT="trader your-email@example.com"
TRADER_STARTING_CASH=100000
TRADER_MAX_POSITION_PCT=0.95
TRADER_MAX_DAILY_LOSS_PCT=0.03
TRADER_KILL_SWITCH_FILE=.kill_switch

# ──────────────────────────────────────────────────────────────
# Option-quote lake roots (data NOT shipped — licensed/ThetaData-derived)
# ──────────────────────────────────────────────────────────────
# Where you keep the option lakes. Leave unset to use repo-relative defaults
# (<repo>/lake/option_eod_quotes and <repo>/lake/option_quote_bars_1m). See
# docs/DATA.md for the partition layout and how to (re)build them.
# TRADER_EOD_LAKE_ROOT=/abs/path/to/lake/option_eod_quotes
# TRADER_LAKE_ROOT=/abs/path/to/lake/option_quote_bars_1m
